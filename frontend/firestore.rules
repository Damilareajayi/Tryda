rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public read access to specific leads so prospects can view audit reports without signing up
    match /leads/{leadId} {
      allow read: if true;
      allow write: if false; // Backends use Admin SDK (which bypasses security rules)
    }

    // Default: Secure all other collections (require authentication)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}